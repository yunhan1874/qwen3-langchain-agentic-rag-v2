# Real-mode model and retrieval configuration
QWEN_MODEL_PATH=Qwen/Qwen3-1.7B
RAG_DOCS_PATH=./data/docs.txt
RAG_INDEX_DIR=./rag_v2_index
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_REWRITE_MAX_NEW_TOKENS=96
RAG_ANSWER_MAX_NEW_TOKENS=256
RAG_LLM_BACKEND=transformers
RAG_VLLM_BASE_URL=http://127.0.0.1:8001/v1
