TRAIN_DATASET_PATH=./data/train.jsonl
VAL_DATASET_PATH=./data/val.jsonl
TRAIN_FORMAT_PATH=./data/train_format.jsonl
TRAIN_OUTPUT_DIR=./output/Qwen3-1.7B

# Web UI
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
